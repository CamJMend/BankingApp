<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="BankAccountTestSuite">
    
    <!-- Running all tests -->
    <test name="AllTests">
        <classes>
            <class name="com.project.BankAccountTest"/>
        </classes>
    </test>
    
    <!-- Running only positive tests -->
    <test name="PositiveTests">
        <groups>
            <run>
                <include name="positive-tests"/>
            </run>
        </groups>
        <classes>
            <class name="com.project.BankAccountTest"/>
        </classes>
    </test>
    
    <!-- Running only negative tests -->
    <test name="NegativeTests">
        <groups>
            <run>
                <include name="negative-tests"/>
            </run>
        </groups>
        <classes>
            <class name="com.project.BankAccountTest"/>
        </classes>
    </test>
    
    <!-- Running tests with dependencies -->
    <test name="DependencyTests">
        <groups>
            <run>
                <include name="dependency-tests"/>
            </run>
        </groups>
        <classes>
            <class name="com.project.BankAccountTest"/>
        </classes>
    </test>
    
    <!-- Running parameterized tests -->
    <test name="ParameterizedTests">
        <parameter name="initialAmount" value="1000.0"/>
        <parameter name="depositAmount" value="500.0"/>
        <groups>
            <run>
                <include name="parameterized-tests"/>
            </run>
        </groups>
        <classes>
            <class name="com.project.BankAccountTest"/>
        </classes>
    </test>
    
</suite>
